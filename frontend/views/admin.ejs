<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CrossFit Grove</title>
<link rel="stylesheet" href="/css/common.css">
<% if (isAuthenticated) { %>
<link rel="stylesheet" href="/css/admin.css">
<% } %>
</head>
<body>

<% if (!isAuthenticated) { %>
<!-- 관리자 로그인 게이트 -->
<div id="admin-gate" style="position:fixed;inset:0;background:#0d0d0d;z-index:9999;display:flex;align-items:center;justify-content:center;flex-direction:column;font-family:-apple-system,sans-serif">
  <div style="text-align:center;width:340px;max-width:90vw">
    <div style="font-family:sans-serif;font-size:24px;font-weight:700;color:#fff;margin-bottom:4px">CrossFit Grove</div>
    <div style="color:#888;font-size:13px;margin-bottom:28px">관리자 로그인</div>
    <input type="password" id="admin-pw" placeholder="비밀번호" style="width:100%;padding:13px;background:#1a1a1a;border:1px solid #333;border-radius:8px;color:#fff;font-size:15px;outline:none;margin-bottom:12px" onkeydown="if(event.key==='Enter')adminLogin()">
    <button onclick="adminLogin()" style="width:100%;padding:13px;background:#c5ff2e;color:#0d0d0d;border:none;border-radius:8px;font-weight:700;font-size:15px;cursor:pointer">로그인</button>
    <div id="admin-pw-error" style="color:#ff6b3d;font-size:13px;margin-top:12px;height:18px"></div>
  </div>
</div>
<script>
async function adminLogin() {
  const pw = document.getElementById('admin-pw').value;
  const res = await fetch('/api/admin/login', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify({password: pw})
  });
  if (res.ok) {
    const data = await res.json();
    sessionStorage.setItem('adminAuth', 'true');
    sessionStorage.setItem('adminToken', data.token);
    location.reload();
  } else {
    const data = await res.json();
    document.getElementById('admin-pw-error').textContent = data.error || '비밀번호가 일치하지 않습니다';
    document.getElementById('admin-pw').value = '';
  }
}
</script>
<% } else { %>



<div class="header">
  <div>
    <div class="header-title">CrossFit Grove</div>
    <div class="header-sub" id="header-who">관리자 대시보드</div>
  </div>
  <div style="display:flex;gap:8px;align-items:center">
    <a href="/contract" class="add-btn" id="contract-write-link" data-perm="contract.write" style="text-decoration:none">📋 계약서 작성</a>
    <button class="action-btn" onclick="adminLogout()">로그아웃</button>
  </div>
</div>

<nav class="nav">
  <button class="nav-btn active" data-perm="home" onclick="openPage('home')">홈</button>
  <button class="nav-btn" data-perm="revenue.list" onclick="openPage('revenue')">매출 관리</button>
  <button class="nav-btn" data-perm="members.list" onclick="openPage('members')">회원 관리</button>
  <button class="nav-btn" data-perm="locker" onclick="openPage('locker-uniform')">락커</button>
  <button class="nav-btn" data-perm="schedule" onclick="openPage('schedule-all')">시간표/신청</button>
  <button class="nav-btn" data-perm="wod" onclick="openPage('wod')">WOD</button>
  <button class="nav-btn" data-perm="notices" onclick="openPage('notices')">공지</button>
  <button class="nav-btn" data-perm="sms" onclick="openPage('sms')">문자 발송</button>
</nav>

<div class="content">

  <!-- 열람 권한이 없는 탭을 눌렀을 때 대신 보여주는 화면 -->
  <div id="page-denied" class="page">
    <div class="card" style="text-align:center;padding:52px 20px">
      <div style="font-size:34px">🔒</div>
      <div style="margin-top:12px;font-size:16px;font-weight:600">열람 권한이 없습니다.</div>
      <div style="margin-top:8px;font-size:13px;color:#888;line-height:1.7">이 화면은 관리자가 허용한 코치만 볼 수 있습니다.<br>필요하시면 관리자에게 요청해 주세요.</div>
    </div>
  </div>

  <!-- 홈 -->
  <div id="page-home" class="page active">
    <div class="metric-grid">
      <div class="metric"><div class="metric-label">활성 회원</div><div class="metric-value" id="stat-members">-</div></div>
      <div class="metric"><div class="metric-label">락커 사용</div><div class="metric-value" id="stat-lockers">-</div><div class="metric-sub">총 152개 중</div></div>
      <div class="metric"><div class="metric-label">만료 임박 (7일)</div><div class="metric-value" id="stat-expiring" style="color:#c62828">-</div></div>
    </div>
    <div class="card">
      <div class="section-two">
        <div>
          <div class="card-title">⏰ 회원권 만료 임박</div>
          <div id="expiring-list"><div class="empty-state">불러오는 중...</div></div>
        </div>
        <div>
          <div class="card-title">🎂 생일</div>
          <div id="birthday-list"><div class="empty-state">불러오는 중...</div></div>
        </div>
      </div>
    </div>
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px">
        <div style="display:flex;align-items:center;gap:10px">
          <div class="card-title" style="margin-bottom:0">📋 신청 (드랍인 · 체험)</div>
