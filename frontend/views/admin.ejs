        <span onclick="selectBulkColor('#1565c0')" style="width:28px;height:28px;border-radius:6px;background:#1565c0;cursor:pointer"></span>
        <span onclick="selectBulkColor('#2e7d32')" style="width:28px;height:28px;border-radius:6px;background:#2e7d32;cursor:pointer"></span>
        <span onclick="selectBulkColor('#c62828')" style="width:28px;height:28px;border-radius:6px;background:#c62828;cursor:pointer"></span>
        <span onclick="selectBulkColor('#e65100')" style="width:28px;height:28px;border-radius:6px;background:#e65100;cursor:pointer"></span>
        <span onclick="selectBulkColor('#6a1b9a')" style="width:28px;height:28px;border-radius:6px;background:#6a1b9a;cursor:pointer"></span>
      </div>
      <input type="hidden" id="bulk-color" value="#1a1a1a">
    </div>

    <div style="margin-bottom:16px">
      <div style="font-size:12px;color:#888;margin-bottom:10px;font-weight:500">요일 × 시간 선택 (체크 = 해당 시간에 수업 있음)</div>
      <div style="overflow-x:auto">
        <table style="border-collapse:collapse;font-size:12px;width:100%">
          <thead>
            <tr>
              <th style="padding:6px 8px;background:#f5f5f5;border:1px solid #e5e5e5;color:#888;font-weight:500;min-width:60px">시간</th>
              <th style="padding:6px 8px;background:#f5f5f5;border:1px solid #e5e5e5;color:#c62828;font-weight:600;text-align:center">일</th>
              <th style="padding:6px 8px;background:#f5f5f5;border:1px solid #e5e5e5;color:#333;font-weight:600;text-align:center">월</th>
              <th style="padding:6px 8px;background:#f5f5f5;border:1px solid #e5e5e5;color:#333;font-weight:600;text-align:center">화</th>
              <th style="padding:6px 8px;background:#f5f5f5;border:1px solid #e5e5e5;color:#333;font-weight:600;text-align:center">수</th>
              <th style="padding:6px 8px;background:#f5f5f5;border:1px solid #e5e5e5;color:#333;font-weight:600;text-align:center">목</th>
              <th style="padding:6px 8px;background:#f5f5f5;border:1px solid #e5e5e5;color:#333;font-weight:600;text-align:center">금</th>
              <th style="padding:6px 8px;background:#f5f5f5;border:1px solid #e5e5e5;color:#1565c0;font-weight:600;text-align:center">토</th>
            </tr>
          </thead>
          <tbody id="bulk-matrix-body"></tbody>
        </table>
      </div>
      <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
        <button class="action-btn" onclick="bulkAddTime()">+ 시간 추가</button>
        <input type="time" id="bulk-new-time" style="padding:5px 8px;border:1px solid #e5e5e5;border-radius:6px;font-size:12px">
        <button class="action-btn" onclick="bulkSelectRow()" style="margin-left:auto">행 전체 선택</button>
        <button class="action-btn" onclick="bulkClearAll()">전체 해제</button>
      </div>
    </div>

    <div id="bulk-preview" style="font-size:12px;color:#888;margin-bottom:12px;min-height:18px"></div>
    <button class="submit-btn" onclick="submitBulkTemplates()">일괄 추가</button>
  </div>
</div>


