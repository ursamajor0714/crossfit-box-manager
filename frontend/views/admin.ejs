    <div id="page-revenue-list" class="sub-page active">
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:16px">
        <div class="card-title" style="margin:0">매출 관리</div>
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
          <select id="rev-month" onchange="renderRevenue()" style="padding:6px 10px;border:1px solid #e5e5e5;border-radius:6px;font-size:13px;background:#fff">
            <option value="">전체 기간</option>
          </select>
          <button onclick="downloadRevenueExcel(this)" style="padding:6px 12px;border:1px solid #2e7d32;background:#2e7d32;color:#fff;border-radius:6px;font-size:13px;cursor:pointer;white-space:nowrap">엑셀 다운로드</button>
          <input type="text" id="rev-search" placeholder="이름 검색..." oninput="renderRevenue()" style="padding:6px 10px;border:1px solid #e5e5e5;border-radius:6px;font-size:13px">
          <select id="rev-filter-source" onchange="renderRevenue()" style="padding:6px 10px;border:1px solid #e5e5e5;border-radius:6px;font-size:13px;background:#fff">
            <option value="">전체 구분</option>
            <option value="회원등록">회원등록</option>
            <option value="드랍인">드랍인</option>
            <option value="락커">락커</option>
            <option value="환불">환불</option>
            <!-- 가계부에서 직접 등록한 매출 (구분이 가계부 항목 이름 그대로 잡힌다) -->
            <option value="물품판매">물품판매</option>
            <option value="기타">기타</option>
          </select>
          <select id="rev-filter-method" onchange="renderRevenue()" style="padding:6px 10px;border:1px solid #e5e5e5;border-radius:6px;font-size:13px;background:#fff">
            <option value="">전체 결제수단</option>
            <option value="현금">현금</option>
            <option value="계좌이체">계좌이체</option>
            <option value="카드">카드</option>
            <option value="환불">환불</option>
          </select>
        </div>
      </div>

      <!-- 요약 -->
      <div id="rev-summary" style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px"></div>

      <div style="overflow-x:auto">
        <table>
          <thead>
            <tr>
              <th onclick="toggleRevenueSort('paid_at')" style="cursor:pointer;user-select:none;white-space:nowrap">결제일시 <span id="revsort-paid_at">↓</span></th>
              <th>구분</th>
              <th>이름</th>
              <th onclick="toggleRevenueSort('amount')" style="cursor:pointer;user-select:none;white-space:nowrap">금액 <span id="revsort-amount">↕</span></th>
              <th>결제수단</th>
              <th>상세</th>
            </tr>
          </thead>
          <tbody id="revenue-tbody"><tr><td colspan="6" class="empty-state">불러오는 중...</td></tr></tbody>
        </table>
      </div>
    </div>
    </div>

    <!-- 가계부: 왼쪽 매출(+) / 오른쪽 지출(-) / 아래 입력줄 -->
    <div id="page-revenue-stats" class="sub-page">
      <div class="card">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:16px">
          <div class="card-title" style="margin:0">가계부</div>
          <div class="ledger-period">
            <button type="button" class="ledger-period-btn" onclick="toggleLedgerCalendar()">
              기간: <span id="ledger-period-label">-</span>
            </button>
            <div class="ledger-cal" id="ledger-cal" hidden>
              <div class="ledger-cal-head">
                <button type="button" onclick="moveLedgerCalMonth(-1)" aria-label="이전 달">‹</button>
                <span id="ledger-cal-title"></span>
                <button type="button" onclick="moveLedgerCalMonth(1)" aria-label="다음 달">›</button>
              </div>
              <div class="ledger-cal-dow"><span>일</span><span>월</span><span>화</span><span>수</span><span>목</span><span>금</span><span>토</span></div>
              <div class="ledger-cal-grid" id="ledger-cal-grid"></div>
              <div class="ledger-cal-foot">
                <button type="button" class="ledger-cal-ghost" onclick="clearLedgerCalDay()">이 달 전체</button>
                <button type="button" class="ledger-cal-ghost" onclick="pickLedgerAllTime()">전체 기간</button>
                <button type="button" class="ledger-cal-ok" onclick="applyLedgerCalendar()">확인</button>
              </div>
            </div>
          </div>
        </div>

        <div id="ledger-summary" class="ledger-summary"></div>

        <div class="ledger-columns">
          <div class="ledger-col">
            <div class="ledger-col-head ledger-col-head--in">
              <span>매출 (+)</span><span id="ledger-income-total">0원</span>
            </div>
            <div style="overflow-x:auto">
              <table>
                <thead><tr><th>항목</th><th>건수</th><th style="text-align:right">금액</th></tr></thead>
                <tbody id="ledger-income-tbody"><tr><td colspan="3" class="empty-state">불러오는 중...</td></tr></tbody>
              </table>
            </div>
          </div>

          <div class="ledger-col">
            <div class="ledger-col-head ledger-col-head--out">
              <span>지출 (−)</span><span id="ledger-expense-total">0원</span>
            </div>
            <div style="overflow-x:auto">
              <table>
                <thead><tr><th>날짜</th><th>항목</th><th>내역</th><th style="text-align:right">금액</th><th></th></tr></thead>
                <tbody id="ledger-expense-tbody"><tr><td colspan="5" class="empty-state">불러오는 중...</td></tr></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- 입력줄: 구분 → 항목 → 금액 → 상세 → 고정비 → 등록 -->
        <div class="ledger-form">
          <details class="ledger-acc" id="ledger-acc-kind">
            <summary><span id="ledger-kind-label">매출</span></summary>
            <div class="ledger-acc-menu">
              <button type="button" onclick="pickLedgerKind('매출')">매출</button>
              <button type="button" onclick="pickLedgerKind('지출')">지출</button>
            </div>
          </details>

          <details class="ledger-acc" id="ledger-acc-category">
            <summary><span id="ledger-category-label">항목 선택</span></summary>
            <div class="ledger-acc-menu" id="ledger-category-menu"></div>
          </details>

          <input type="number" id="ledger-amount" placeholder="금액" min="1" step="1" inputmode="numeric" class="ledger-amount">
          <input type="text" id="ledger-detail" placeholder="상세 내역" maxlength="500" class="ledger-detail">

          <label class="ledger-fixed">
            <input type="checkbox" id="ledger-fixed">
            <span>고정비로 등록 (매월)</span>
          </label>

          <button type="button" class="ledger-submit" onclick="addLedgerEntry(this)">등록</button>
        </div>
        <div id="ledger-form-error" class="ledger-error"></div>
      </div>
    </div>
  </div>


  <!-- 회원 관리 (서브탭) -->
  <div id="page-members" class="page">
    <div id="member-sub-denied" class="sub-page">
      <div class="card" style="text-align:center;padding:52px 20px">
      <div style="font-size:34px">🔒</div>
      <div style="margin-top:12px;font-size:16px;font-weight:600">열람 권한이 없습니다.</div>
      <div style="margin-top:8px;font-size:13px;color:#888;line-height:1.7">이 화면은 관리자가 허용한 코치만 볼 수 있습니다.<br>필요하시면 관리자에게 요청해 주세요.</div>
    </div>
    </div>
    <div class="sub-tabs">
      <button class="sub-tab active" data-perm="members.list" onclick="openMemberSubTab('list',this)">회원 목록</button>
      <button class="sub-tab" data-perm="members.register" onclick="openMemberSubTab('register',this)">등록</button>
      <button class="sub-tab" data-perm="members.contracts" onclick="openMemberSubTab('contracts',this)">📝 계약서</button>
      <button class="sub-tab" data-perm="members.counts" onclick="openMemberSubTab('counts',this)">횟수권</button>
      <button class="sub-tab" data-perm="members.holding" onclick="openMemberSubTab('holding',this)">홀딩</button>
      <button class="sub-tab" data-perm="members.special" onclick="openMemberSubTab('special',this)">특별연장</button>
      <button class="sub-tab" data-perm="members.pricing" onclick="openMemberSubTab('pricing',this)">가격표</button>
    </div>
    <div id="member-sub-list" class="sub-page active">
    <div class="card">
      <div class="search-row">
        <input type="text" id="search-input" placeholder="이름 또는 연락처 검색..." oninput="filterMembers()">
        <select id="filter-status" onchange="filterMembers()">
          <option value="all">전체</option>
          <option value="active">활성</option>
          <option value="expiring">만료 임박</option>
          <option value="inactive">만료</option>
        </select>
      </div>
      <table>
        <thead>
          <tr>
            <th onclick="toggleSort('name')" style="cursor:pointer;user-select:none">회원명 <span id="sort-name">↕</span></th>
            <th onclick="toggleSort('regcreated')" style="cursor:pointer;user-select:none">등록시각 / 결제 <span id="sort-regcreated">↕</span></th>
            <th onclick="toggleSort('start')" style="cursor:pointer;user-select:none">시작일 <span id="sort-start">↕</span></th>
            <th onclick="toggleSort('end')" style="cursor:pointer;user-select:none">만료일 <span id="sort-end">↕</span></th>
            <th onclick="toggleFilter('locker')" style="cursor:pointer;user-select:none" id="th-locker">락커</th>
            <th>보충자료 필요</th>
            <th onclick="toggleFilter('status')" style="cursor:pointer;user-select:none" id="th-status">상태</th>
            <th>관리</th>
          </tr>
        </thead>
        <tbody id="member-tbody"><tr><td colspan="8" class="empty-state">불러오는 중...</td></tr></tbody>
      </table>
    </div>
    </div>
    <div id="member-sub-register" class="sub-page">
    <div class="card" style="max-width:720px">
      <div class="card-title">회원 등록</div>
      <div class="tabs-inline">
        <button class="tab-sm active" onclick="setRegType(this,'new')">신규 등록</button>
        <button class="tab-sm" onclick="setRegType(this,'renew')">재등록</button>
      </div>

      <!-- 신규/재등록 공통 -->
      <div id="reg-new">
        <div class="form-grid">
          <div class="form-group"><label>회원명 *</label><input type="text" id="reg-name" placeholder="홍길동"></div>
          <div class="form-group"><label>연락처</label><input type="text" id="reg-phone" placeholder="010-0000-0000"></div>
          <div class="form-group"><label>성별</label><select id="reg-gender"><option value="">선택</option><option value="남">남</option><option value="여">여</option></select></div>
          <div class="form-group"><label>연령대</label><select id="reg-age"><option value="10대">10대</option><option value="20대">20대</option><option value="30대" selected>30대</option><option value="40대">40대</option><option value="50대">50대</option></select></div>
          <div class="form-group"><label>요금제</label><select id="reg-plan" onchange="calcPrice()"><option value="">선택...</option></select></div>
          <div class="form-group"><label>기간</label>
            <select id="reg-period" onchange="onPeriodChange()"><option value="">선택...</option><option value="1">1개월</option><option value="3">3개월</option><option value="6">6개월</option><option value="custom">만료일 직접입력</option></select>
          </div>
          <div class="form-group"><label>결제 수단</label><select id="reg-payment"><option value="카드">카드</option><option value="계좌이체">계좌이체</option><option value="현금">현금</option></select></div>
          <div class="form-group"><label>할인율</label><select id="reg-discount" onchange="calcPrice()"><option value="0">없음</option><option value="0.01">1% (지인소개)</option><option value="0.05">5% (출석이벤트)</option><option value="0.1">10% (직업할인)</option></select></div>
          <div class="form-group"><label>시작일</label><input type="date" id="reg-start" onchange="calcEndDate()"></div>
          <div class="form-group"><label>만료일</label><input type="date" id="reg-end" readonly style="background:#f9f9f9"></div>
          <div class="form-group"><label>홀딩 부여 (일)</label><input type="number" id="reg-holding" value="0" min="0" title="3개월=10일, 6개월=30일 자동"></div>
          <div class="form-group"><label>지역</label><input type="text" id="reg-region" placeholder="군자동"></div>
          <div class="form-group"><label>가입 경로</label><select id="reg-source"><option>인스타</option><option>네이버</option><option>지인</option><option>기존</option><option>오프라인</option></select></div>
