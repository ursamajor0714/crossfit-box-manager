<div class="modal-bg" id="bulk-template-modal">
  <div class="modal" style="width:600px">
    <div class="modal-title"><span>⚡ 반복 템플릿 일괄 추가</span><button class="modal-close" onclick="closeModal('bulk-template-modal')">✕</button></div>

    <div style="margin-bottom:16px">
      <div style="font-size:12px;color:#888;margin-bottom:8px;font-weight:500">수업명 *</div>
      <input type="text" id="bulk-class" placeholder="예: CrossFit" style="width:100%;padding:9px 12px;border:1px solid #e5e5e5;border-radius:8px;font-size:13px;outline:none">
    </div>

    <div style="margin-bottom:16px">
      <div style="font-size:12px;color:#888;margin-bottom:8px;font-weight:500">색상</div>
